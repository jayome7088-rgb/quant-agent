{
  "name": "quant-agent",
  "version": "1.0.7",
  "description": "QuantAgent — autonomous AI agent for quantitative financial research. A refined fork of virattt/dexter.",
  "type": "module",
  "main": "src/index.tsx",
  "bin": {
    "quant-agent": "./src/index.tsx"
  },
  "scripts": {
    "start": "bun run src/index.tsx",
    "web": "bun run src/web/server.ts",
    "dev": "bun --watch run src/index.tsx",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "dependencies": {
    "@langchain/core": "^1.1.36",
    "better-sqlite3": "^12.8.0",
    "dotenv": "^17.3.1",
    "ink": "^5.2.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "openai": "^5.17.0",
    "react": "18.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "latest",
    "@types/react": "18.3.23",
    "typescript": "^5.9.3"
  }
}
